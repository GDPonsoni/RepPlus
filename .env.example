# Copie para .env e preencha. O .env nunca vai para o git.

# Banco Postgres no Neon (Connect → com "Connection pooling" ligado e desligado)
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://usuario:senha@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Imagens no Cloudflare R2, bucket privado (R2 → Manage API tokens → Object Read & Write no bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=repplus-uploads

# Login pela senha da casa. Sem AUTH_MODO (ou "aberto"), o app abre sem senha, só para testes locais
AUTH_MODO=senha
SENHA_CASA=
# 32+ caracteres aleatórios, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSAO_SEGREDO=

# Opcional: protege o agendador de Finanças (GET /api/financas/sincronizar)
CRON_SECRET=

# Só para importar os dados do app antigo (npm run db:importar-supabase); pode apagar depois
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
